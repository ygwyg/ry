{
  "name": "route-yes-example",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Must be "none": with "404-page" or "single-page-application", misses are
    // answered by the assets layer and never reach the Worker.
    "not_found_handling": "none"
  },
  "ai": { "binding": "AI" },
  // Optional decision cache. The Cache API doesn't work on *.workers.dev, so
  // KV keeps repeat visitors from re-asking Clef. To use your own:
  // `wrangler kv namespace create ROUTE_YES_CACHE`, or delete this block.
  "kv_namespaces": [
    { "binding": "ROUTE_YES_CACHE", "id": "c2c37b89b89d4890804748b929ffa484" }
  ]
}
